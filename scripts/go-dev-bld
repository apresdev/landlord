#!/usr/bin/env bash

set -Eeuo pipefail
set -x

mockery

go get -v

goimports -w .

go fmt ./...

if [[ "${LANDLORD_SKIP_TESTS:-}" == "" ]];
then
    go test -v ./...
fi

# TODO: investigate golangci-lint
# golint ./...
staticcheck ./...

go vet -v ./...
go mod tidy

MAIN_PKG='main'
BUILD_TIME=$(date +"%Y%m%d.%H%M%S")
CommitHash=N/A
GoVersion=N/A

if [[ $(go version) =~ [0-9]+\.[0-9]+\.[0-9]+ ]];
then
    GoVersion=${BASH_REMATCH[0]}
fi

GH=$(git log -1 --pretty=format:%h || echo 'N/A')
if [[ "$GH" =~ 'fatal' ]];
then
    CommitHash=N/A
else
    CommitHash=$GH
fi

FLAG="-X $MAIN_PKG.BuildTime=$BUILD_TIME"
FLAG="$FLAG -X $MAIN_PKG.CommitHash=$CommitHash"
FLAG="$FLAG -X $MAIN_PKG.GoVersion=$GoVersion"

if [[ "${1:-}" == "install" ]];
then
    go install -v -ldflags "$FLAG"
else
    go build -v -ldflags "$FLAG"
fi
