#!/usr/bin/env bash
#
# Builds and runs the AWS Emulator (https://aws.amazon.com/products/developer-tools/emulator/)
# in Docker, for running the integration-style tests without an AWS account.
#
#   scripts/aws-emulator start    # build the image if needed, start, wait for health
#   scripts/aws-emulator stop
#   scripts/aws-emulator env      # print exports; use: eval "$(scripts/aws-emulator env)"
#
# Then: go test ./...   (tests that need AWS skip if the emulator is not running)
#
# The emulator keeps state in memory only and generates new credentials and a
# new CA on every start, so run `env` after `start`.

set -euo pipefail

PORT="${EMULATOR_PORT:-9297}"
NAME=landlord-aws-emulator
DIR="$HOME/.aws/emulator/$PORT"

case "$(uname -m)" in
  arm64|aarch64) ARCH=aarch64; PLATFORM=linux/arm64 ;;
  *)             ARCH=x86_64;  PLATFORM=linux/amd64 ;;
esac
IMAGE="aws-emulator:$ARCH"

build() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 && return
  docker build -q --platform "$PLATFORM" -t "$IMAGE" - >/dev/null <<DOCKERFILE
FROM public.ecr.aws/amazonlinux/amazonlinux:2023-minimal
ADD https://downloads.aws.com/aws-emulator/packages/aws-emulator/LTS/latest/aws-emulator-$ARCH.rpm /tmp/aws-emulator.rpm
RUN rpm -i /tmp/aws-emulator.rpm && rm /tmp/aws-emulator.rpm && mkdir -p /home/emulator && chown 1000 /home/emulator
USER 1000
ENV HOME=/home/emulator EMULATOR_BIND_ADDRESS=0.0.0.0
ENTRYPOINT ["aws-emulator"]
DOCKERFILE
}

case "${1:-}" in
  start)
    build
    mkdir -p "$HOME/.aws/emulator"
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    docker run -d --rm --name "$NAME" --platform "$PLATFORM" --memory=2g \
      -p "127.0.0.1:$PORT:$PORT" -e HOME="$HOME" \
      -v "$HOME/.aws/emulator:$HOME/.aws/emulator" "$IMAGE" -p "$PORT" >/dev/null
    for _ in $(seq 1 30); do
      if curl -sf --cacert "$DIR/ca.pem" "https://127.0.0.1:$PORT/__admin/health" >/dev/null 2>&1; then
        echo "emulator ready on https://127.0.0.1:$PORT"
        exit 0
      fi
      sleep 1
    done
    echo "emulator did not become healthy" >&2
    docker logs "$NAME" >&2
    exit 1
    ;;
  stop)
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    ;;
  env)
    cat <<ENV
export AWS_ENDPOINT_URL=https://127.0.0.1:$PORT
export AWS_SHARED_CREDENTIALS_FILE=$DIR/emulator_credentials
export AWS_CONFIG_FILE=$DIR/config
export AWS_CA_BUNDLE=$DIR/ca.pem
export AWS_EC2_METADATA_DISABLED=true
export AWS_DISABLE_HOST_PREFIX_INJECTION=true
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1
export AWS_PROFILE=default
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
ENV
    ;;
  *)
    echo "usage: $0 start|stop|env" >&2
    exit 2
    ;;
esac
