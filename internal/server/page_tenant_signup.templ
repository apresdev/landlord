package server

templ tenantSignupPage(tenantName string, username string) {
    <div>
        <h1>You are not yet signed up for { tenantName }</h1>
        <form action='/signup/submit' method='post'>
            <label>Username:
                <input type='text' name='username' value={ username } />
            </label>
            <input type='submit' />
        </form>
    </div>
}
