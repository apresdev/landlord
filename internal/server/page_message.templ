package server

templ messagePage(appName string, msg string) {
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{ appName } | Message</title>
    <link rel="stylesheet" href="/static/landlord.css">
</head>
<body>
    <div class="container">
        <h2>{ appName } | Message</h2>
        <h3>{ msg }</h3>
        <h3><a href="/">Back</a></h3>
    </div>
</body>
</html>
}
