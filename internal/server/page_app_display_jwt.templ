package server

templ displayJWTPage(idToken, accessToken string) {
    <div>
        <a href="/ll-auth/app/logout">Logout</a> |
        <a href="/ll-auth/app/admin/tenants">Tenants</a>
        <pre>
            { idToken }
        </pre>
        <pre>
            { accessToken }
        </pre>
    </div>
}
