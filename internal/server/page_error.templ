package server

templ errorPage(appName, appAdminEmail string, mailToAdminLink templ.SafeURL, errMsg, navText string, navURL templ.SafeURL) {
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{ appName } | Error</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .container {
            background-color: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            max-width: 400px;
            width: 100%;
        }
        .container h2 {
            margin-bottom: 20px;
            font-size: 24px;
            text-align: center;
        }
        .container h3 {
            margin-bottom: 10px;
            font-size: 20px;
            text-align: center;
            color: red;
        }
        .container div {
            margin-bottom: 10px;
            font-size: 16px;
            text-align: center;
        }
        .container input[type="email"],
        .container input[type="password"] {
            width: calc(100% - 22px);
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        .container button {
            width: calc(100% - 22px);
            padding: 10px;
            margin: 10px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .container button:hover {
            background-color: #45a049;
        }
        .container .recovery {
            text-align: center;
            margin: 10px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>{ appName } | Error</h2>
        <h3>{ errMsg }</h3>
        <div>For assistance, contact: <a href={ mailToAdminLink }>{ appAdminEmail }</a></div>
        <div class="recovery">
            <a href={ navURL } >{ navText }</a>
        </div>
    </div>
</body>
</html>
}
