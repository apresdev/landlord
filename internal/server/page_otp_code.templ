package server

templ otpCodePage(appName string, username string) {
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{ appName } | Login</title>
    <link rel="stylesheet" href="static/landlord.css">
</head>
<body>
    <div class="container">
        <h2>{ appName } | Authenticator Code</h2>
        <form action="/otp/submit" method="POST">
            <label>Code
                <input type="text" name="code" placeholder="Enter the code from your authenticator app..." required>
            </label>
            <input type="hidden" name="username" value={ username } />
            <button type="submit">Submit</button>
        </form>
        <div class="recovery">
            <a href="/recovery">Account Recovery</a>
            |
            <a href="/logout">Logout</a>
        </div>
    </div>
</body>
</html>
}
