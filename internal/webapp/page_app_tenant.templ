package webapp

import "github.com/apresdev/landlord/internal/multi"

const tenantPageTitle = "Tenant"

templ tenantPage(appName string, tenant *multi.Tenant, users []*multi.User, loggedInUser *multi.User) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, tenantPageTitle)
<body>
    @navBarFragment(loggedInUser)
    <div class="container">
        <a href="/ll-auth/app/admin/tenants"><button>Tenants</button></a>
        <a href={ templ.SafeURL("/admin/tenants/" + tenant.ID.String() + "/invite") }><button>Invite User</button></a>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>MFA</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody hx-target="closest tr" hx-swap="outerHTML">
            for _, user := range users {
                @userFragment(user)
            }
            </tbody>
        </table>
    </div>
</body>
</html>
}
