package webapp

import "github.com/apresdev/landlord/internal/authx"
import "github.com/apresdev/landlord/internal/multi"

const dashboardPageTitle = "Dashboard"

templ dashboardPage(appName string, currentUser *CurrentUser, stats DashboardStats) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, tenantsPageTitle)
<body>
    @navBarFragment(currentUser)
    <div class="card-container">
        <div class="card-grid-container">
            <div class="card">
                <div class="card-header">
                    <i class="fa-sharp fa-solid fa-shield-exclamation fa-2x"></i>
                    <h3>Alerts</h3>
                </div>
                <div class="card-body">
                    <p>{ stats.SecurityAlertMessage }</p>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <i class="fa-sharp fa-solid fa-calendar-users fa-2x"></i>
                    <h3>Invites</h3>
                </div>
                <div class="card-body">
                    <p><a href="/ll-auth/app/admin/tenant-select?action=manage-invites">
                        Manage Invites <i class="fa-sharp fa-arrow-right"></i>
                    </a></p>
                    <p><a href="/ll-auth/app/admin/tenant-select?action=manage-invites">Invite User <i class="fa-sharp fa-arrow-right"></i></a></p>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <i class="fa-sharp fa-solid fa-buildings fa-2x"></i>
                    <h3>Tenants</h3>
                </div>
                <div class="card-body">
                    <p><a href="/ll-auth/app/admin/tenants">
                        Manage Tenants <i class="fa-sharp fa-arrow-right"></i>
                    </a></p>
                    <p><a href="/ll-auth/app/admin/tenants/new">
                        Create New Tenant <i class="fa-sharp fa-arrow-right"></i>
                    </a></p>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <i class="fa-sharp fa-solid fa-users fa-2x"></i>
                    <h3>Users</h3>
                </div>
                <div class="card-body">
                    <p><a href="/ll-auth/app/admin/tenant-select?action=manage-users">
                        Manage Users <i class="fa-sharp fa-arrow-right"></i>
                    </a></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
}
