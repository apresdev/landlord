package webapp

templ unauthorizedPage(appName string, errMsg string) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, "Unauthorized")
<body>
    @navBarFragment(nil)
    <div class="error-container">
      <h2>Error Occurred</h2>
      <p>{ errMsg }</p>
      <a href="/ll-auth/app/login">Return to Login</a>
    </div>
</body>
</html>
}

templ errorPage(
    appName string,
    appAdminEmail string,
    mailToAdminLink templ.SafeURL,
    errMsg string,
    navText string,
    navURL templ.SafeURL) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, "Error")
<body>
    @navBarFragment(nil)
    <div class="error-container">
        <h2>Error Occurred</h2>
        <p>{ errMsg }</p>
        <p>If the error persists, contact: <a href={ mailToAdminLink }>{ appAdminEmail }</a></p>
        <a href={ navURL } >{ navText }</a>
    </div>
</body>
</html>
}
