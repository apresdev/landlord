package webapp

import "github.com/apresdev/landlord/internal/multi"

const inviteUserPageTitle = "Invite User"

templ inviteUserPage(
    appName string,
    currentUser *CurrentUser,
    inviteToTenant *multi.Tenant,
    initialUsername string,
    mfaPolicies []string) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, inviteUserPageTitle)
<body>
    @navBarFragment(currentUser)
    <div class="container">
        <h2>Invite user to tenant: { inviteToTenant.Name }</h2>
        <form class="form-wrapper" action={ templ.SafeURL("/ll-auth/app/admin/tenants/" + inviteToTenant.ID.String() + "/users") } method="POST">
            <label>Email:
                <input type="text" name="username" value={ initialUsername } />
            </label>
            <label>Role:
                <select id="role" name="role">
                    for _, role := range inviteToTenant.Roles {
                        <option value={ role }>{ role }</option>
                    }
                </select>
            </label>
            <label>MFA Policy:
                <select id="mfaPolicy" name="mfaPolicy">
                    for _, mfaPolicy := range mfaPolicies {
                        <option value={ mfaPolicy }>{ mfaPolicy }</option>
                    }
                </select>
            </label>
            <button class="button" type="submit">Invite</button>
        </form>
    </div>
</body>
</html>
}
