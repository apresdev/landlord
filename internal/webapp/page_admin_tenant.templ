package webapp

import "github.com/apresdev/landlord/internal/multi"
import "github.com/google/uuid"
import "net/url"
import "strconv"
import "strings"

const tenantPageTitle = "Tenant"

templ roleFragment(tenantID string, role RoleWithCount) {
<tr>
    <td>{ role.Role }</td>
    <td>{ strconv.Itoa(role.Count) }</td>
    <td>
        if role.RemovableTooltip == "" {
            <button
                class="button"
                hx-delete={ "/ll-auth/app/admin/tenants/" + tenantID + "/roles/" + role.Role }
                hx-target="#add-role-table-and-form"
            >
                Remove
            </button>
        } else {
            <button class="button" disabled>
                Remove
                <span class="tooltip">{ role.RemovableTooltip }</span>
            </button>
        }
    </td>
</tr>
}

templ tenantAddRoleButton(tenantID string) {
    <div id="add-role-form">
        <button hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/add-role-form" } hx-target="#add-role-form" class="button">Add Role</button>
    </div>
}

templ tenantAddRoleForm(tenantID string) {
<form
    class="form-wrapper"
    hx-post={ string(templ.SafeURL("/ll-auth/app/admin/tenants/" + tenantID + "/roles")) }
    hx-target="#add-role-table-and-form"
    hx-swap="innerHTML"
>
    <label>
        <input type="text" name="role" placeholder="Enter role">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/add-role-button" }
        hx-target="#add-role-form"
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ tenantAddRoleTableAndForm(
    tenant *multi.Tenant,
    roles []RoleWithCount,
    errMsg string) {
<div id="add-role-table-and-form">
    @tenantAddRoleButton(tenant.ID.String())
    <div id="add-role-error-message" style="color: red; margin-top: 10px;">{ errMsg }</div>
    <table>
        <thead>
            <tr>
                <th>Role Name</th>
                <th>Members</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
        for _, role := range roles {
            @roleFragment(tenant.ID.String(), role)
        }
        </tbody>
    </table>
</div>
}

templ userFragment(du *DisplayableUser) {
<tr>
    <td><a href={ appURL("/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String()) }>
        { du.User.Username }
    </a></td>
    <td>{ du.User.Role }</td>
    <td>{ du.MFAStatus() }</td>
    <td>{ du.Status() }</td>
    <td>
        if du.User.Status == multi.UserStatusActive {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/deactivate" }
            >
                Deactivate
            </button>
        } else if du.User.Status == multi.UserStatusInvited {
            <button
                class="button"
                hx-get={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/invite?username=" + url.QueryEscape(du.User.Username) }
            >
                Resend Invite
            </button>
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/cancel-invite" }
            >
                Cancel Invite
            </button>
        } else if du.User.Status == multi.UserStatusInactive {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/activate" }
            >
                Activate
            </button>
        }
        if du.User.MFAPolicy == multi.MFAPolicyNone {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/mfa/enable" }
            >
                Attach MFA
            </button>
        } else {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/mfa/disable" }
            >
                Detach MFA
            </button>
        }
    </td>
</tr>
}

templ tenantInviteUserButton(tenantID string) {
    <div id="invite-user-form">
        <button
            hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/invite-user-form" }
            hx-target="#invite-user-form"
            class="button">Invite User</button>
    </div>
}

templ tenantInviteUserForm(tenantID string, inviteToTenant *multi.Tenant, mfaPolicies []string) {
<form
    class="form-wrapper"
    hx-post={ string(templ.SafeURL("/ll-auth/app/admin/tenants/" + tenantID + "/users")) }
    hx-target="#invite-user-table-and-form"
    hx-swap="innerHTML"
>
    <label>Email:
        <input type="text" name="username" placeholder="Enter email address">
    </label>
    <label>Role:
        <select id="role" name="role">
            for _, role := range inviteToTenant.Roles {
                <option value={ role }>{ role }</option>
            }
        </select>
    </label>
    <label>MFA Policy:
        <select id="mfaPolicy" name="mfaPolicy">
            for _, mfaPolicy := range mfaPolicies {
                <option value={ mfaPolicy }>{ mfaPolicy }</option>
            }
        </select>
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/invite-user-button" }
        hx-target="#invite-user-form"
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ tenantInviteUserTableAndForm(
    tenantID uuid.UUID,
    dus []*DisplayableUser,
    errMsg string) {
<div id="invite-user-table-and-form">
    @tenantInviteUserButton(tenantID.String())
    <div id="invite-user-error-message" style="color: red; margin-top: 10px;">{ errMsg }</div>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th>MFA</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
        for _, du := range dus {
            @userFragment(du)
        }
        </tbody>
    </table>
</div>
}

templ tenantSummary(
    appName string,
    currentUser *CurrentUser,
    tenant *multi.Tenant,
    userPoolURL string,
    users []*multi.User,
    roles []RoleWithCount) {

<div class="card">
    <div class="card-header">
        <h2>Tenant Summary</h2>
    </div>
    <div class="card-columns">
        <!-- Column 1 -->
        <div class="column">
            <h3>Details</h3>
            <div class="field">
                <span class="label">Name</span>
                <span class="value">{ tenant.Name }</span>
            </div>
            <div class="field">
                <span class="label">Description</span>
                @tenantDescriptionForm(tenant.ID.String(), tenant.Description)
            </div>
            <div class="field">
                <span class="label">Cognito User Pool</span>
                <span class="value">
                    <i class="fa-brands fa-aws"></i>
                    <a href={ templ.SafeURL(userPoolURL) } target="_blank">{ tenant.UserPoolID }</a>
                </span>
            </div>
        </div>

        <!-- Column 2 -->
        <div class="column">
            <h3>Roles</h3>
            <div class="field">
                <span class="label">Roles</span>
                <span class="value">{ strings.Join(tenant.Roles, ", ") }</span>
            </div>
            <div class="field">
                <span class="label">Sub-Roles</span>
                <span class="value">{ strings.Join(tenant.SubTenantRoles, ", ") }</span>
            </div>
        </div>

        <!-- Column 3 -->
        <div class="column">
            <h3>Additional Information</h3>
            <div class="field">
                <span class="label">Time Created</span>
                <span class="value">{ displayTimestamp(tenant.CreatedAt) }</span>
            </div>
            <div class="field">
                <span class="label">State</span>
                <span class="value">{ string(tenant.State) }</span>
            </div>
        </div>
    </div>
</div>
}

templ tenantDescriptionForm(
    tenantID string, description string) {
<span class="value" id="edit-description-form">
    { description }
    <button
        class="icon-button"
        hx-get={ appPath("/admin/tenants/" + tenantID + "/description/edit") }
        hx-target="#edit-description-form">
        <i class="fa-sharp fa-pen-to-square"></i>
    </button>
</span>
}

templ tenantDescriptionEditForm(
    tenantID string,
    description string) {
<form
    class="form-wrapper"
    hx-post={ "/ll-auth/app/admin/tenants/" + tenantID + "/description/edit" }
    hx-target="#edit-description-form"
    hx-swap="innerHTML"
>
    <label>
        <input type="text" name="description" value={ description } maxlength="256">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/description/form" }
        hx-target="#edit-description-form"
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ tenantSummaryTab(
    tab string,
    appName string,
    currentUser *CurrentUser,
    tenant *multi.Tenant,
    userPoolURL string,
    users []*multi.User,
    roles []RoleWithCount) {

<div class="tab-header" role="tablist">
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/summary") }
	    class="tab-button active"
	    role="tab"
	    aria-selected="true"
	    aria-controls="tab-content">Summary</button>
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/users") }
	    class="tab-button"
	    role="tab"
	    aria-selected="false"
	    aria-controls="tab-content">Users</button>
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/roles") }
	    class="tab-button"
	    role="tab"
	    aria-selected="false"
	    aria-controls="tab-content">Roles</button>
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @tenantSummary(appName, currentUser, tenant, userPoolURL, users, roles)
</div>
}

templ tenantUsersTab(
     tab string,
     appName string,
     currentUser *CurrentUser,
     tenant *multi.Tenant,
     dus []*DisplayableUser,
     roles []RoleWithCount) {

<div class="tab-header" role="tablist">
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/summary") }
	    class="tab-button"
	    aria-selected="false"
	    aria-controls="tab-content">Summary</button>
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/users") }
	    class="tab-button active"
	    role="tab"
	    aria-selected="true"
	    aria-controls="tab-content">Users</button>
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/roles") }
	    class="tab-button"
	    aria-selected="false"
	    aria-controls="tab-content">Roles</button>
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @tenantInviteUserTableAndForm(tenant.ID, dus, "")
</div>
}

templ tenantRolesTab(
     tab string,
     appName string,
     currentUser *CurrentUser,
     tenant *multi.Tenant,
     users []*multi.User,
     roles []RoleWithCount) {

<div class="tab-header" role="tablist">
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/summary") }
	    class="tab-button"
	    role="tab"
	    aria-selected="false"
	    aria-controls="tab-content">Summary</button>
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/users") }
	    class="tab-button"
	    role="tab"
	    aria-selected="false"
	    aria-controls="tab-content">Users</button>
	<button
	    hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/roles") }
	    class="tab-button active"
	    role="tab"
	    aria-selected="true"
	    aria-controls="tab-content">Roles</button>
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @tenantAddRoleTableAndForm(tenant, roles, "")
</div>
}

templ tenantPage(
    appName string,
    currentUser *CurrentUser,
    tenant *multi.Tenant) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, tenantPageTitle)
<body>
    @navBarFragment(currentUser)
    <div class="container">
        <div id="tabs"
	        hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/summary") }
            hx-trigger="load delay:100ms"
            hx-target="#tabs"
            hx-swap="innerHTML"></div>
    </div>
</body>
</html>
}

