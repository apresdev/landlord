package webapp

import "github.com/apresdev/landlord/internal/multi"
import "github.com/apresdev/landlord/internal/tinytools"
import "github.com/google/uuid"
import "strconv"
import "strings"
import "golang.org/x/text/cases"
import "golang.org/x/text/language"

const tenantPageTitle = "Tenant"

templ roleFragment(tenantID string, role RoleWithCount) {
<tr>
    <td>{ role.Role }</td>
    <td>{ strconv.Itoa(role.Count) }</td>
    <td>
        if role.RemovableTooltip == "" {
            <button
                class="button"
                hx-delete={ "/ll-auth/app/admin/tenants/" + tenantID + "/roles/" + role.Role }
                hx-target="#add-role-table-and-form"
            >
                Remove
            </button>
        } else {
            <button class="button" disabled>
                Remove
                <span class="tooltip">{ role.RemovableTooltip }</span>
            </button>
        }
    </td>
</tr>
}

templ tenantAddRoleButton(tenantID string) {
    <div id="add-role-form">
        <button hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/add-role-form" } hx-target="#add-role-form" class="button">Add Role</button>
    </div>
}

templ tenantAddRoleForm(tenantID string) {
<form
    class="form-wrapper"
    hx-post={ string(templ.SafeURL("/ll-auth/app/admin/tenants/" + tenantID + "/roles")) }
    hx-target="#add-role-table-and-form"
    hx-swap="innerHTML"
>
    <label>
        <input type="text" name="role" placeholder="Enter role">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/add-role-button" }
        hx-target="#add-role-form"
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ tenantAddRoleTableAndForm(
    tenant *multi.Tenant,
    roles []RoleWithCount,
    errMsg string) {
<div id="add-role-table-and-form">
    @tenantAddRoleButton(tenant.ID.String())
    <div id="add-role-error-message" style="color: red; margin-top: 10px;">{ errMsg }</div>
    <table>
        <thead>
            <tr>
                <th>Role Name</th>
                <th>Members</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
        for _, role := range roles {
            @roleFragment(tenant.ID.String(), role)
        }
        </tbody>
    </table>
</div>
}


templ subRoleFragment(tenantID string, subRole RoleWithCount) {
<tr>
    <td>{ subRole.Role }</td>
    <td>
        if subRole.RemovableTooltip == "" {
            <button
                class="button"
                hx-delete={ "/ll-auth/app/admin/tenants/" + tenantID + "/sub-roles/" + subRole.Role }
                hx-target="#add-sub-role-table-and-form"
            >
                Remove
            </button>
        } else {
            <button class="button" disabled>
                Remove
                <span class="tooltip">{ subRole.RemovableTooltip }</span>
            </button>
        }
    </td>
</tr>
}

templ tenantAddSubRoleButton(tenantID string) {
    <div id="add-sub-role-form">
        <button hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/add-sub-role-form" } hx-target="#add-sub-role-form" class="button">Add Sub Role</button>
    </div>
}

templ tenantAddSubRoleForm(tenantID string) {
<form
    class="form-wrapper"
    hx-post={ string(templ.SafeURL("/ll-auth/app/admin/tenants/" + tenantID + "/sub-roles")) }
    hx-target="#add-sub-role-table-and-form"
    hx-swap="innerHTML"
>
    <label>
        <input type="text" name="subrole" placeholder="Enter sub role">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/add-sub-role-button" }
        hx-target="#add-sub-role-form"
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ tenantAddSubRoleTableAndForm(
    tenant *multi.Tenant,
    subRoles []RoleWithCount,
    errMsg string) {
<div id="add-sub-role-table-and-form">
    @tenantAddSubRoleButton(tenant.ID.String())
    <div id="add-role-error-message" style="color: red; margin-top: 10px;">{ errMsg }</div>
    <table>
        <thead>
            <tr>
                <th>Sub Role Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
        for _, role := range subRoles {
            @subRoleFragment(tenant.ID.String(), role)
        }
        </tbody>
    </table>
</div>
}

templ userFragment(sub *DisplayableSubject, du *DisplayableUser) {
<tr>
    <td><a href={ appURL("/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String()) }>
        { du.User.Username }
    </a></td>
    <td>{ du.User.Role }</td>
    <td>{ du.MFAStatus() }</td>
    <td>{ du.Status() }</td>
    <td>
        if du.SubjectCanImpersonate() {
            if sub.IsImpersonatingUser(du) {
                <button
                    class="button"
                    hx-post="/ll-auth/app/admin/clear-impersonation"
                >
                    Clear Impersonation
                </button>
            } else if !sub.IsUser(du) {
                <button
                    class="button"
                    hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/impersonate" }
                >
                    Impersonate
                </button>
            }
        }
        if du.User.Status == multi.UserStatusActive {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/deactivate" }
            >
                Deactivate
            </button>
        } else if du.User.Status == multi.UserStatusInvited {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/reinvite" }
            >
                Resend Invite
            </button>
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/cancel-invite" }
            >
                Cancel Invite
            </button>
        } else if du.User.Status == multi.UserStatusInactive {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/activate" }
            >
                Activate
            </button>
        }
        if du.User.MFAPolicy == multi.MFAPolicyNone {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/mfa/enable" }
            >
                Attach MFA
            </button>
        } else if du.User.MFAStatus == multi.MFAStatusActive && du.User.Status == multi.UserStatusActive {
            <button
                class="button"
                hx-post={ "/ll-auth/app/admin/tenants/" + du.User.TenantID.String() + "/users/" + du.User.ID.String() + "/mfa/disable" }
            >
                Detach MFA
            </button>
        }
    </td>
</tr>
}

templ tenantInviteUserButton(tenantID string) {
    <div id="invite-user-form">
        <button
            hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/invite-user-form" }
            hx-target="#invite-user-form"
            class="button">Invite User</button>
    </div>
}

templ tenantInviteUserForm(tenantID string, inviteToTenant *multi.Tenant, mfaPolicies []string) {
<form
    class="form-wrapper"
    hx-post={ string(templ.SafeURL("/ll-auth/app/admin/tenants/" + tenantID + "/users")) }
    hx-target="#invite-user-table-and-form"
    hx-swap="innerHTML"
>
    <label>Email:
        <input type="text" name="username" placeholder="Enter email address">
    </label>
    <label>Role:
        <select id="role" name="role">
            for _, role := range inviteToTenant.Roles {
                <option value={ role }>{ role }</option>
            }
        </select>
    </label>
    <label>MFA Policy:
        <select id="mfaPolicy" name="mfaPolicy">
            for _, mfaPolicy := range mfaPolicies {
                <option value={ mfaPolicy }>{ mfaPolicy }</option>
            }
        </select>
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/invite-user-button" }
        hx-target="#invite-user-form"
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ tenantInviteUserTableAndForm(
    tenantID uuid.UUID,
    sub *DisplayableSubject,
    dus []*DisplayableUser,
    errMsg string) {
<div id="invite-user-table-and-form">
    @tenantInviteUserButton(tenantID.String())
    <div id="invite-user-error-message" style="color: red; margin-top: 10px;">{ errMsg }</div>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th>MFA</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
        if len(dus) == 0 {
            <tr>
                <td colspan="5">No users</td>
            </tr>
        } else {
            for _, du := range dus {
                @userFragment(sub, du)
            }
        }
        </tbody>
    </table>
</div>
}

templ tenantSummary(
    appName string,
    sub *DisplayableSubject,
    tenant *multi.Tenant,
    userPoolURL string,
    users []*multi.User) {

<div class="card">
    <div class="card-header">
        <h2>Tenant Summary</h2>
    </div>
    <div class="card-columns">
        <!-- Column 1 -->
        <div class="column">
            <h3>Details</h3>
            <div class="field">
                <span class="label">Name</span>
                <span class="value">{ tenant.Name }</span>
            </div>
            <div class="field">
                <span class="label">Description</span>
                @tenantDescriptionForm(tenant.ID.String(), tenant.Description)
            </div>
            <div class="field">
                <span class="label">Cognito User Pool</span>
                <span class="value">
                    <i class="fa-brands fa-aws"></i>
                    <a href={ templ.SafeURL(userPoolURL) } target="_blank">{ tenant.UserPoolID }</a>
                </span>
            </div>
        </div>

        <!-- Column 2 -->
        <div class="column">
            <h3>Roles</h3>
            <div class="field">
                <span class="label">Roles</span>
                <span class="value">
                    { strings.Join(tenant.Roles, ", ") }
                    <button
                        class="icon-button"
                        hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/" + string(tenantTabRoles)) }>
                        <i class="fa-sharp fa-pen-to-square"></i>
                    </button>
                </span>
            </div>
            <div class="field">
                <span class="label">Sub-Roles</span>
                <span class="value">
                    { strings.Join(tenant.SubTenantRoles, ", ") }
                    <button
                        class="icon-button"
                        hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/" + string(tenantTabSubRoles)) }>
                        <i class="fa-sharp fa-pen-to-square"></i>
                    </button>
                </span>
            </div>
        </div>

        <!-- Column 3 -->
        <div class="column">
            <h3>Additional Information</h3>
            <div class="field">
                <span class="label">Time Created</span>
                <span class="value">{ displayTimestamp(tenant.CreatedAt) }</span>
            </div>
            <div class="field">
                <span class="label">State</span>
                <span class="value">{ string(tenant.State) }</span>
            </div>
        </div>
    </div>
</div>
}

templ tenantDescriptionForm(
    tenantID string, description string) {
<span class="value" id="edit-description-form">
    { description }
    <button
        class="icon-button"
        hx-get={ appPath("/admin/tenants/" + tenantID + "/description/edit") }
        hx-target="#edit-description-form">
        <i class="fa-sharp fa-pen-to-square"></i>
    </button>
</span>
}

templ tenantDescriptionEditForm(
    tenantID string,
    description string) {
<form
    class="form-wrapper"
    hx-post={ "/ll-auth/app/admin/tenants/" + tenantID + "/description/edit" }
    hx-target="#edit-description-form"
    hx-swap="innerHTML"
>
    <label>
        <input type="text" name="description" value={ description } maxlength="256">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ "/ll-auth/app/admin/tenants/" + tenantID + "/description/form" }
        hx-target="#edit-description-form"
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ tenantTabButtonsFragment(tenantID string, selectedTab tenantTab) {
    for _, tab := range tenantTabs {
        <button
            hx-get={ appPath("/admin/tenants/" + tenantID + "/" + string(tab)) }
            class={ "tab-button" + tinytools.StringIf(tab == selectedTab, " active") }
            role="tab"
            aria-selected={ strconv.FormatBool(tab == selectedTab) }
            aria-controls="tab-content">{ cases.Title(language.English).String(string(tab)) }</button>
    }
}

templ tenantSummaryTab(
    appName string,
    sub *DisplayableSubject,
    tenant *multi.Tenant,
    userPoolURL string,
    users []*multi.User,
    baseURL string) {

<div class="tab-header" role="tablist">
    @tenantTabButtonsFragment(tenant.ID.String(), "summary")
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @tenantSummary(appName, sub, tenant, userPoolURL, users)
    @profileCard("Tenant Profile", tenant.GetTenantProfileDefinition(), tenant, baseURL)
</div>
}

templ tenantUsersTab(
     appName string,
     sub *DisplayableSubject,
     tenant *multi.Tenant,
     dus []*DisplayableUser) {

<div class="tab-header" role="tablist">
    @tenantTabButtonsFragment(tenant.ID.String(), tenantTabUsers)
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @tenantInviteUserTableAndForm(tenant.ID, sub, dus, "")
</div>
}

templ tenantInvitesTab(
     appName string,
     sub *DisplayableSubject,
     tenant *multi.Tenant,
     invitedDUs []*DisplayableUser) {

<div class="tab-header" role="tablist">
    @tenantTabButtonsFragment(tenant.ID.String(), tenantTabInvites)
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @tenantInviteUserTableAndForm(tenant.ID, sub, invitedDUs, "")
</div>
}

templ tenantRolesTab(
     appName string,
     sub *DisplayableSubject,
     tenant *multi.Tenant,
     users []*multi.User,
     roles []RoleWithCount) {

<div class="tab-header" role="tablist">
    @tenantTabButtonsFragment(tenant.ID.String(), tenantTabRoles)
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @tenantAddRoleTableAndForm(tenant, roles, "")
</div>
}

templ tenantSubRolesTab(
     appName string,
     sub *DisplayableSubject,
     tenant *multi.Tenant,
     users []*multi.User,
     subRoles []RoleWithCount) {

<div class="tab-header" role="tablist">
    @tenantTabButtonsFragment(tenant.ID.String(), tenantTabSubRoles)
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @tenantAddSubRoleTableAndForm(tenant, subRoles, "")
</div>
}


templ tenantPage(
    appName string,
    sub *DisplayableSubject,
    tenant *multi.Tenant,
    startingTab string) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, tenantPageTitle)
<body>
    @navBarFragment(sub)
    <div class="container">
        <div id="tabs"
	        hx-get={ appPath("/admin/tenants/" + tenant.ID.String() + "/" + startingTab) }
            hx-trigger="load delay:100ms"
            hx-target="#tabs"
            hx-swap="innerHTML"></div>
    </div>
</body>
</html>
}

