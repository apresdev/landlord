package webapp

import "github.com/apresdev/landlord/internal/multi"

const tenantsPageTitle = "Tenants"

templ tenantsPage(appName string, sub *DisplayableSubject, tenants []*multi.Tenant) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, tenantsPageTitle)
<body>
    @navBarFragment(sub)
    <div class="container">
        <a href="/ll-auth/app/admin/tenants/new"><button class="button">Create New Tenant</button></a>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Description</th>
                    <th>User Pool</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody hx-target="closest tr" hx-swap="outerHTML">
            for _, tenant := range tenants {
                @tenantFragment(tenant)
            }
            </tbody>
        </table>
    </div>
</body>
</html>
}
