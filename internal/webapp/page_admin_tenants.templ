package webapp

import "github.com/apresdev/landlord/internal/multi"

const tenantsPageTitle = "Tenants"

templ tenantsPage(appName string, sub *DisplayableSubject, tenants []*multi.Tenant) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, tenantsPageTitle)
<body>
    @navBarFragment(sub)
    <div class="container">
        @tenantCreateTenantTableAndForm(tenants, "")
    </div>
</body>
</html>
}

templ tenantCreateTenantButton() {
    <div id="create-tenant-form">
        <button
            hx-get={ appPath("/admin/tenant-ops/create-tenant-form") }
            hx-target="#create-tenant-form"
            class="button">Create New Tenant</button>
    </div>
}

templ tenantCreateTenantForm() {
<form
    class="form-wrapper"
    hx-post={ appPath("/admin/tenant-ops/create-tenant-submit") }
    hx-target="#create-tenant-table-and-form"
    hx-swap="innerHTML"
>
    <label>Name:
        <input type="text" name="name" />
    </label>
    <label>Description:
        <input type="text" name="description" />
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ appPath("/admin/tenant-ops/create-tenant-button") }
        hx-target="#create-tenant-form"
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ tenantCreateTenantTableAndForm(tenants []*multi.Tenant, errMsg string) {
<div id="create-tenant-table-and-form">
    @tenantCreateTenantButton()
    if errMsg != "" {
        <div id="create-tenant-error-message" class="error-text">{ errMsg }</div>
    }
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Description</th>
                <th>User Pool</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
        for _, tenant := range tenants {
            @tenantFragment(tenant)
        }
        </tbody>
    </table>
</div>
}
