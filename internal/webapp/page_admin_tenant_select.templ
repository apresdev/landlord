package webapp

import "github.com/apresdev/landlord/internal/multi"

script onTenantSelect(tenantID string, tab string) {
    window.location.href = "/ll-auth/app/admin/tenants/" + tenantID + "?tab=" + tab;
}

templ tenantSelectFragment(tenant *multi.Tenant, tab string) {
<tr class="clickable" onclick={ onTenantSelect(tenant.ID.String(), tab) }>
    <td><a href={ templ.SafeURL("/ll-auth/app/admin/tenants/" + tenant.ID.String() + "?tab=" + tab) }>{ tenant.Name }</a></td>
    <td>{ tenant.Description }</td>
</tr>
}

templ tenantSelectPage(appName string, sub *DisplayableSubject, tenants []*multi.Tenant, tab string) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, tenantsPageTitle)
<body>
    @navBarFragment(sub)
    <div class="container">
        <h2>Select Tenant</h2>
        <table>
            <tbody hx-target="closest tr" hx-swap="outerHTML">
            for _, tenant := range tenants {
                @tenantSelectFragment(tenant, tab)
            }
            </tbody>
        </table>
    </div>
</body>
</html>
}
