{{ define "unauthorized" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.UnauthenticatedView*/}}
<!DOCTYPE html>
<html lang="en">
{{ template "header" . }}
<body>
    <section class="hero is-fullheight">
      <div class="hero-body">
        <div class="container">
          <div class="columns is-centered">
            <div class="column is-5">
              <div class="box has-text-centered">
            <span class="icon is-large has-text-danger mb-5">
              <i class="fa-sharp fa-exclamation-circle fa-3x"></i>
            </span>
                <h2 class="title is-3 has-text-danger">Unrecoverable Error</h2>
                  {{ if .ErrMsg }}
                    <p class="subtitle is-5 has-text-grey mb-6">{{ .ErrMsg }}</p>
                  {{ else }}
                    <p class="subtitle is-5 has-text-grey mb-6">Error message unknown (37).</p>
                  {{ end }}
                <p>If the error persists, contact:
                  <a href={{ .Settings.AdminEmailLink }}>{{ .Settings.AdminEmail }}</a>
                </p>
                <a href="/ll-auth/app/login">Return to Login</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
</body>
</html>
{{ end }}
