{{ define "loginPage" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.UnauthenticatedView*/}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Settings.AppName }} | Login</title>
    <link rel="stylesheet" href="/ll-auth/app/static/landlord-login.css">
</head>
<body>
    <div class="container">
        <h2>{{ .Settings.AppName }} | Login</h2>
        <form action="/ll-auth/app/login/submit" method="POST">
            <label>Email
                <input type="email" name="username" placeholder="Email" value="{{ .PotentialUsername }}" required autofocus>
            </label>
            <label>Password
                <input type="password" name="password" placeholder="Password" required>
            </label>
            <button type="submit">Login</button>
        </form>
        <div class="recovery">
            <a href="/ll-auth/app/recovery">Account Recovery</a>
            |
            <a href="/ll-auth/app/logout">Logout</a>
        </div>
    </div>
</body>
</html>
{{ end }}
