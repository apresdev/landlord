{{ define "recoveryPage" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.UnauthenticatedView*/}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Settings.AppName }} | Account Recovery</title>
    <link rel="stylesheet" href="/ll-auth/app/static/landlord-login.css">
</head>
<body>
    <div class="container">
        <h2>{{ .Settings.AppName }} | Recovery Account</h2>
        <form action="/ll-auth/app/recovery/submit" method="POST">
            <label>Email
                <input type="email"
                    name="username"
                    placeholder="Enter email address to start recovery..."
                    value="{{ .PotentialUsername }}" required>
            </label>
            <button type="submit">Recover</button>
        </form>
    </div>
</body>
</html>
{{ end }}
