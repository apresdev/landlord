{{ define "helpPage" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.SettingsProvider*/}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Settings.AppName }} | Help</title>
    <link rel="stylesheet" href="/ll-auth/app/static/landlord-login.css">
</head>
<body>
    <div class="container">
        <h2>{{ .Settings.AppName }} | Help</h2>
        <div>
        Custom content related to the application that could also provide
        links to additional resources found here.
        </div>
        <div class="recovery">
            <a href="/ll-auth/app/recovery">Account Recovery</a>
        </div>
    </div>
</body>
</html>
{{ end }}
