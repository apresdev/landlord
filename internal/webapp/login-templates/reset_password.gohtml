{{ define "resetPasswordPage" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.UnauthenticatedView*/}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Settings.AppName }} | Reset Password</title>
    <link rel="stylesheet" href="/ll-auth/app/static/landlord-login.css">
</head>
<body>
    <div class="container">
        <h2>{{ .Settings.AppName }} | Enter New Password</h2>
        <h3>Enter new password for: {{ .PotentialUsername }}</h3>
        <form action="/ll-auth/app/reset-password/submit" method="POST">
            <label>Confirmation Code:
                <input type="number" max="1000000" name="confirmation-code" />
            </label>
            <label>New Password:
                <input type="password" name="password-one" />
            </label>
            <label>Confirm Password:
                <input type="password" name="password-two" />
            </label>
            <input type="hidden" name="username" value="{{ .PotentialUsername }}" />
            <button type="submit">Update</button>
        </form>
        <div class="recovery">
            <a href="/ll-auth/app/logout">Logout</a>
        </div>
    </div>
</body>
</html>
{{ end }}
