{{ define "otpCodePage" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.UnauthenticatedView*/}}
<!DOCTYPE html>
<html lang="en">
{{ template "header" . }}
<body>
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-4">
                    <div class="container has-text-centered">
                        <div class="is-size-2">Landlord Console</div>
                        <div class="is-size-3">Enter Authenticator Code</div>
                    </div>
                    <div class="box">
                        <form action="/ll-auth/app/otp/submit" method="POST">
                            <input type="hidden" name="username" value="{{ .PotentialUsername }}" />
                            <!-- Code Field -->
                            <div class="field">
                                <label class="label">Authenticator Code</label>
                                <div class="control has-icons-left">
                                    <input class="input"
                                           type="text"
                                           name="code"
                                           placeholder="Code from your authenticator app..."
                                           required autofocus>
                                    <span class="icon is-small is-left">
                                        <i class="fa-sharp fa-solid fa-key"></i>
                                    </span>
                                </div>
                            </div>

                            {{ if ne .ErrMsg "" }}
                                <div class="notification is-danger">
                                    {{ .ErrMsg }}
                                </div>
                            {{ end }}

                            <!-- Submit Button -->
                            <div class="field">
                                <div class="control">
                                    <button class="button is-primary is-fullwidth">
                                        Submit
                                    </button>
                                </div>
                            </div>

                            <!-- Links -->
                            <div class="has-text-centered mt-4">
                                <a href="/ll-auth/app/logout">Logout</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
{{ end }}
