{{ define "otpCodePage" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.UnauthenticatedView*/}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Settings.AppName }} | Login</title>
    <link rel="stylesheet" href="/ll-auth/app/static/landlord-login.css">
</head>
<body>
    <div class="container">
        <h2>{{ .Settings.AppName }} | Authenticator Code</h2>
        <form action="/ll-auth/app/otp/submit" method="POST">
            <label>Code
                <input type="text" name="code" placeholder="Enter the code from your authenticator app..." required>
            </label>
            <input type="hidden" name="username" value="{{ .PotentialUsername }}" />
            <button type="submit">Submit</button>
        </form>
        <div class="recovery">
            <a href="/ll-auth/app/recovery">Account Recovery</a>
            |
            <a href="/ll-auth/app/logout">Logout</a>
        </div>
    </div>
</body>
</html>
{{ end }}
