package webapp

import "github.com/apresdev/landlord/internal/multi"
import "github.com/google/uuid"

const userPageTitle = "User"

templ userSummaryCard(
    tenant *multi.Tenant,
    user *multi.User,
    cogUser *DisplayableCognitoUser) {

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h2>User Summary</h2>
            </div>
            <div class="card-columns">
                <!-- Column 1 -->
                <div class="column">
                    <h3>Details</h3>
                    <div class="field">
                        <span class="label">Name</span>
                        <span class="value">{ user.Username }</span>
                    </div>
                    <div class="field">
                        <span class="label">MFA Policy</span>
                        <span class="value">{ user.MFAPolicy.String() }</span>
                    </div>
                    <div class="field">
                        <span class="label">Cognito User ID</span>
                        <span class="value">
                            <a href={ templ.SafeURL(cogUser.cogURL) } target="_blank">{ user.ID.String() }</a>
                        </span>
                    </div>
                </div>

                <!-- Column 2 -->
                <div class="column">
                    <h3>Role</h3>
                    <div class="field">
                        <span class="label">Tenant</span>
                        <span class="value">
                            <a href={ templ.SafeURL("/ll-auth/app/admin/tenants/" + tenant.ID.String()) }>{ tenant.Name }</a>
                        </span>
                    </div>
                    <div class="field">
                        <span class="label">Role</span>
                        <span class="value">{ user.Role }</span>
                    </div>
                    <div class="field">
                        <span class="label">Impersonation</span>
                        if cogUser.IsImpersonating() {
                            <span class="value">{ cogUser.ImpersonationName() }</span>
                            <button
                                class="button"
                                hx-post="/ll-auth/app/admin/clear-impersonation"
                            >
                                Clear Impersonation
                            </button>
                        } else {
                            <span class="value">None</span>
                        }
                    </div>
                </div>

                <!-- Column 3 -->
                <div class="column">
                    <h3>Additional Information</h3>
                    <div class="field">
                        <span class="label">Time Created</span>
                        <span class="value">{ displayTimestamp(user.CreatedAt) }</span>
                    </div>
                    <div class="field">
                        <span class="label">State</span>
                        <span class="value">{ string(user.Status) }</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

templ profileFieldForm(
    tenantID uuid.UUID,
    userID uuid.UUID,
    defn *multi.ProfileFieldDefinition,
    value string) {
<span class="value" id={ "edit-" + defn.Name }>
    { value }
    <button
        class="icon-button"
        hx-get={ appPath("/admin/tenants/" + tenantID.String() + "/users/" + userID.String() + "/field/edit?fieldName=" + defn.Name) }
        hx-target={ "#edit-" + defn.Name }>
        <i class="fa-sharp fa-pen-to-square"></i>
    </button>
</span>
}

templ profileEditFieldForm(
    tenantID uuid.UUID,
    userID uuid.UUID,
    defn *multi.ProfileFieldDefinition,
    value string) {
<form
    class="form-wrapper"
    hx-post={ appPath("/admin/tenants/" + tenantID.String() + "/users/" + userID.String() + "/field/edit?fieldName=" + defn.Name) }
    hx-target={ "#edit-" + defn.Name }
    hx-swap="innerHTML"
>
    <label>
        <input type={ defn.Format.HTMLInputType() } name="fieldValue" value={ value } maxlength="256" autofocus>
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get={ appPath("/admin/tenants/" + tenantID.String() + "/users/" + userID.String() + "/field/form?fieldName=" + defn.Name) }
        hx-target={ "#edit-" + defn.Name }
        hx-swap="innerHTML">Cancel</button>
</form>
}

templ userProfileCard(
    tenant *multi.Tenant,
    user *multi.User,
    cogUser *DisplayableCognitoUser) {

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h2>User Profile</h2>
            </div>
            <div class="card-columns">
                <!-- Column 1 -->
                <div class="column">
                for _, profileDefinition := range tenant.GetProfileDefinition().Fields {
                    <div class="field">
                        <span class="label">{ profileDefinition.UIName }</span>
                        @profileFieldForm(
                            tenant.ID,
                            user.ID,
                            &profileDefinition,
                            user.ProfileField(profileDefinition.Name))
                    </div>
                }
                </div>
            </div>
        </div>
    </div>
}

templ userSummary(
    appName string,
    sub *DisplayableSubject,
    tenant *multi.Tenant,
    user *multi.User,
    cogUser *DisplayableCognitoUser) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, userPageTitle)
<body>
    @navBarFragment(sub)
    @userSummaryCard(tenant, user, cogUser)
    @userProfileCard(tenant, user, cogUser)
</body>
</html>
}

