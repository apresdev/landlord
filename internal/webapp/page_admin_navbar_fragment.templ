package webapp

templ navBarFragment(sub *DisplayableSubject) {
<div class="nav-bar">
    <div class="nav-left">
        <ul>
            <li><a href="/ll-auth/app/admin/dashboard">
                <img src="/ll-auth/app/static/favicon-32x32.png"  alt="Landlord" />
            </a></li>
            <li><a href="/ll-auth/app/admin/dashboard">Dashboard</a></li>
            <li><a href="/ll-auth/app/admin/tenants">Tenants</a></li>
            <li><a href="/ll-auth/app/admin/tenant-ops/select?action=manage-invites">Invites</a></li>
            <li><a href="/ll-auth/app/admin/tenant-ops/select?action=manage-users">Users</a></li>
            // TODO: disable UI for search -- not yet implemented
            // <li>
                // <label>
                    // <input type="text" placeholder="Search...">
                // </label>
            // </li>
            // <li>
                // <button type="submit">
                    // <i class="fa-sharp fa-solid fa-search fa-2x"></i>
                // </button>
            // </li>
        </ul>
    </div>
    <div class="nav-right">
        if sub != nil {
            <div class="profile">
                if sub.IsImpersonating() {
                    <a href="/ll-auth/app/admin/profile">
                        { sub.ImpersonationName() }
                    </a>
                }
                <a href="/ll-auth/app/admin/profile">
                    { sub.Username() }
                </a>
                <a href={ templ.SafeURL("/ll-auth/app/admin/tenants/" + sub.TenantID().String()) }>
                    { sub.TenantName() }
                </a>
                <a href="/ll-auth/app/admin/profile">Profile</a>
                <a href="/ll-auth/app/logout">Logout</a>
            </div>
        }
    </div>
</div>
}
