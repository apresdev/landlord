{{ define "tenantSelectFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<tr class="clickable" onclick="navigateTo('{{ .Link }}')">
    <td><a href="{{ .Link }}">{{ .Name }}</a></td>
    <td>{{ .Description }}</td>
</tr>
{{ end }}

{{ define "selectTenant" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<!DOCTYPE html>
<html lang="en">
{{ template "header" . }}
<body>
    {{ template "navbar" . }}
    <div class="container">
        <h2>Select Tenant</h2>
        <table>
            <tbody hx-target="closest tr" hx-swap="outerHTML">
                {{ range .Tenants }}
                    {{ template "tenantSelectFragment" . }}
                {{ end }}
            </tbody>
        </table>
    </div>
</body>
</html>
{{ end }}
