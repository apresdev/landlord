{{ define "profile" }}
    {{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
    <!DOCTYPE html>
    <html lang="en">
    {{ template "header" . }}
    <body>
        {{ template "navbar" . }}
        <div class="section">
            <div class="columns">
                <div class="column is-one-fifth"></div>
                <div class="column">
                    <div class="container">
                        <div id="profile-tabs"
                             hx-get="{{ printf "/ll-auth/app/admin/profile/%s" .ProfileTab }}"
                             hx-trigger="load delay:100ms"
                             hx-target="#profile-tabs"
                             hx-swap="innerHTML">
                        </div>
                    </div>
                </div>
                <div class="column is-one-fifth"></div>
            </div>
        </div>
    </body>
    </html>
{{ end }}

{{ define "profileTabButtonsFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
    <ul>
        {{ range .ProfileTabs }}
            {{ template "profileTabButton" . }}
        {{ end }}
    </ul>
{{ end }}

{{ define "profileTabButton" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.ProfileTab*/}}
    <li class="tab {{ ifElse .Active "is-active" "" }}">
        <a hx-get="{{ .Link }}"
           hx-target="#profile-tabs"
           hx-swap="innerHTML"
           role="tab"
           aria-selected="{{ .Active }}"
           aria-controls="tab-content">
            {{ .Title }}
        </a>
    </li>
{{ end }}

{{ define "profileSummaryTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tabs" role="tablist">
    {{ template "profileTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="container">
    {{ template "userSummaryCard" .SelectedUser }}
</div>
{{ end }}

{{ define "profileDetailsTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tabs" role="tablist">
    {{ template "profileTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="container">
    {{ template "profileCard" .SelectedUser.Profile }}
</div>
{{ end }}

{{ define "profileTokenDisplay" }}
<div><pre>{{ .Subject.AccessToken }}</pre></div>
{{ end }}

{{ define "profileTokenTab" }}
<div class="tabs" role="tablist">
    {{ template "profileTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="container">
    {{ template "profileTokenDisplay" . }}
</div>
{{ end }}

{{ define "profileFieldForm" }}
    {{- /*gotype: github.com/apresdev/landlord/internal/webapp.ProfileFieldView*/}}
    <span class="value" id="{{ printf "edit-%s" .Name }}">
        {{ .Value }}
        <button class="icon-button"
                hx-get="{{ .EditLink }}"
                hx-target="{{ printf "#edit-%s" .Name }}">
            <i class="fa-sharp fa-pen-to-square"></i>
        </button>
    </span>
{{ end }}

{{ define "profileEditFieldForm" }}
    {{- /*gotype: github.com/apresdev/landlord/internal/webapp.ProfileFieldView*/}}
    <form class="form-wrapper"
          hx-post="{{ .EditLink }}"
          hx-target="{{ printf "#edit-%s" .Name }}"
          hx-swap="innerHTML">
        <label>
            <input class="input" type="{{ .HTMLInputType }}" name="fieldValue" value="{{ .Value }}" maxlength="256" autofocus>
        </label>
        <button class="button is-primary mt-2" type="submit">Submit</button>
        <button class="button mt-2" type="button"
                hx-get="{{ .FormLink }}"
                hx-target="{{ printf "#edit-%s" .Name }}"
                hx-swap="innerHTML">
            Cancel
        </button>
    </form>
{{ end }}

{{ define "profileCard" }}
    {{- /*gotype: github.com/apresdev/landlord/internal/webapp.ProfileFieldsView*/}}
    <div class="container">
        <div class="card">
            <div class="card-columns">
                <div class="column">
                    {{ range .Fields }}
                        <div class="field">
                            <span class="label">{{ .UIName }}</span>
                            {{ template "profileFieldForm" . }}
                        </div>
                    {{ end }}
                </div>
            </div>
        </div>
    </div>
{{ end }}
