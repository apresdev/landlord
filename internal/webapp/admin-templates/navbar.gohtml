{{ define "navbar" }}
    {{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
    <nav class="navbar" role="navigation" aria-label="main navigation">
        <div class="navbar-brand">
            <a class="navbar-item" href="/">
                <img src="/ll-auth/app/static/favicon-32x32.png"  alt="Landlord" />
            </a>
            <a class="navbar-burger" role="button" aria-label="menu" aria-expanded="false">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>

        <div id="mainNavbar" class="navbar-menu">
            <div class="navbar-start">
                <a class="navbar-item" href="/ll-auth/app/admin/tenants">
                    Tenants
                </a>
            </div>

            <div class="navbar-end">
                {{ if .Subject }}
                    {{ if .Subject.IsImpersonating }}
                        <a class="navbar-item" href="/ll-auth/app/admin/profile">
                            {{ .Subject.ImpersonationName }}
                        </a>
                    {{ end }}
                    <a class="navbar-item" href="/ll-auth/app/admin/profile">
                        {{ .Subject.Username }}
                    </a>
                    <a class="navbar-item" href="{{ .Subject.TenantLink }}">
                        {{ .Subject.TenantName }}
                    </a>
                    <a class="navbar-item" href="/ll-auth/app/admin/profile">Profile</a>
                {{ end }}

                <div class="navbar-item">
                    <div class="buttons">
                        <a class="button is-light" href="/ll-auth/app/logout">
                            Log out
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
{{ end }}
