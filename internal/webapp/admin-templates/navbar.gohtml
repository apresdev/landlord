{{ define "navbar" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="nav-bar">
    <div class="nav-left">
        <ul>
            <li><a href="/ll-auth/app/admin/dashboard">
                <img src="/ll-auth/app/static/favicon-32x32.png"  alt="Landlord" />
            </a></li>
            <li><a href="/ll-auth/app/admin/dashboard">Dashboard</a></li>
            <li><a href="/ll-auth/app/admin/tenants">Tenants</a></li>
            <li><a href="/ll-auth/app/admin/tenant-ops/select?action=manage-invites">Invites</a></li>
            <li><a href="/ll-auth/app/admin/tenant-ops/select?action=manage-users">Users</a></li>
        </ul>
    </div>
    <div class="nav-right">
        {{ if .Subject }}
            <div class="profile">
                {{ if .Subject.IsImpersonating }}
                    <a href="/ll-auth/app/admin/profile">
                        {{ .Subject.ImpersonationName }}
                    </a>
                {{ end }}
                <a href="/ll-auth/app/admin/profile">
                    {{ .Subject.Username }}
                </a>
                <a href="{{ .Subject.TenantLink }}">
                    {{ .Subject.TenantName }}
                </a>
                <a href="/ll-auth/app/admin/profile">Profile</a>
                <a href="/ll-auth/app/logout">Logout</a>
            </div>
        {{ end }}
    </div>
</div>
{{ end }}
