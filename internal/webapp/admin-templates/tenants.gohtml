{{ define "tenants" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<!DOCTYPE html>
<html lang="en">
{{ template "header" . }}
<body>
    {{ template "navbar" . }}
    <section class="section landlord-background-section">
        <div class="container">
            <div class="panel is-primary landlord-panel">
                <p class="panel-heading">Tenants</p>
                <div class="panel-block">
                    <div class="container">
                        {{ template "createTenantTableAndForm" . }}
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
{{ end }}

{{ define "createTenantButton" }}
<div id="create-tenant-form">
    <button
        hx-get="/ll-auth/app/admin/tenant-ops/create-tenant-form"
        hx-target="#create-tenant-form"
        class="button">Create New Tenant</button>
</div>
{{ end }}

{{ define "createTenantForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div id="create-tenant-form">
  {{ if .ErrMsg }}
    <div id="create-tenant-error-message" class="has-text-danger">{{ .ErrMsg }}</div>
  {{ end }}
  <form class="form-wrapper"
    hx-post="/ll-auth/app/admin/tenant-ops/create-tenant-submit"
    hx-target="#create-tenant-table-and-form"
    hx-swap="innerHTML">
    <label class="mt-1">Name:
        <input class="input" type="text" name="name" />
    </label>
    <label class="mt-1">Description:
        <input class="input" type="text" name="description" />
    </label>
    <button class="button is-primary mt-2" type="submit">Submit</button>
    <button class="button mt-2" type="button"
        hx-get="/ll-auth/app/admin/tenant-ops/create-tenant-button"
        hx-target="#create-tenant-form"
        hx-swap="innerHTML">Cancel</button>
  </form>
</div>
{{ end }}

{{ define "createTenantTableAndForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div id="create-tenant-table-and-form">
  {{ if .ErrMsg }}
      {{ template "createTenantForm" . }}
  {{ else }}
      {{ template "createTenantButton" }}
  {{ end }}
    <div class="container mt-4">
      <div class="box">
    <table id="tenants-table" class="datatable display">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
        {{ range .Tenants }}
            {{ template "tenantFragment" . }}
        {{ end }}
        </tbody>
    </table>
      </div>
    </div>
</div>
{{ end }}
