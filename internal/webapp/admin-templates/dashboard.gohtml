{{ define "dashboard" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<!DOCTYPE html>
<html lang="en">
{{ template "header" . }}
<body>
    {{ template "navbar" . }}
    <div class="card-container">
        <div class="card-grid-container">
            <div class="card">
                <div class="card-header">
                    <i class="fa-sharp fa-solid fa-shield-exclamation fa-2x"></i>
                    <h3>Alerts</h3>
                </div>
                <div class="card-body">
                    <p>No current security alerts</p>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <i class="fa-sharp fa-solid fa-calendar-users fa-2x"></i>
                    <h3>Invites</h3>
                </div>
                <div class="card-body">
                    <p><a href="/ll-auth/app/admin/tenant-ops/select?action=manage-invites">
                        Manage Invites <i class="fa-sharp fa-arrow-right"></i>
                    </a></p>
                    <p><a href="/ll-auth/app/admin/tenant-ops/select?action=manage-invites">Invite User <i class="fa-sharp fa-arrow-right"></i></a></p>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <i class="fa-sharp fa-solid fa-buildings fa-2x"></i>
                    <h3>Tenants</h3>
                </div>
                <div class="card-body">
                    <p><a href="/ll-auth/app/admin/tenants">
                        Manage Tenants <i class="fa-sharp fa-arrow-right"></i>
                    </a></p>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <i class="fa-sharp fa-solid fa-users fa-2x"></i>
                    <h3>Users</h3>
                </div>
                <div class="card-body">
                    <p><a href="/ll-auth/app/admin/tenant-ops/select?action=manage-users">
                        Manage Users <i class="fa-sharp fa-arrow-right"></i>
                    </a></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
{{ end }}
