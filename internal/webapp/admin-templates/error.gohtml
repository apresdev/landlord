{{ define "error" }}
    {{- /*gotype: github.com/apresdev/landlord/internal/webapp.ErrorPageView*/}}
    <!DOCTYPE html>
    <html lang="en">
    {{ template "header" . }}
    <body>
        <section class="hero is-fullheight">
            <div class="hero-body">
                <div class="container">
                    <div class="columns is-centered">
                        <div class="column is-5">
                            <div class="box has-text-centered">
                                <span class="icon is-large has-text-danger mb-5">
                                  <i class="fa-sharp fa-exclamation-circle fa-3x"></i>
                                </span>
                                <h2 class="title is-3 has-text-danger">Unrecoverable Error</h2>
                                {{ if .ErrMsg }}
                                    <p class="subtitle is-4 mb-6">{{ .ErrMsg }}</p>
                                {{ else }}
                                    <p class="subtitle is-4 mb-6">Could not determine error</p>
                                {{ end }}
                                <p>If the error persists, contact:
                                    <a href="{{ .Settings.AdminEmailLink }}">{{ .Settings.AdminEmail }}</a>
                                </p>
                                <a href="/">Back</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        {{ template "footer" .Settings }}
    </body>
    </html>
{{ end }}
