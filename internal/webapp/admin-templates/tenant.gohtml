{{ define "tenantFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<tr>
    <td><a href="{{ .Link }}">{{ .Name }}</a></td>
    <td>{{ .Description }}</td>
    <td>{{ .State }}</td>
    <td>
        <div class="buttons are-small">
            {{ if .IsActive }}
            <a href="{{ printf "/ll-auth/app/admin/tenants/%s?tab=invites" .ID }}">
                <button class="button is-primary is-outlined">Invite User</button>
            </a>
            {{ end }}
            {{ if not .IsRoot }}
                {{ if .IsActive }}
                    <button class="button is-danger is-outlined"
                            hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/deactivate" .ID }}">
                        Deactivate
                    </button>
                {{ else }}
                    <button class="button"
                            hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/activate" .ID }}">
                        Activate
                    </button>
                {{ end }}
            {{ end }}
        </div>
    </td>
</tr>
{{ end }}

{{ define "roleFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.RoleView*/}}
<tr>
    <td class="numeric-column">{{ .Count }}</td>
    <td>{{ .Name }}</td>
    <td>
        <button class="button is-small is-primary is-outlined"
                hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/roles/%s/impersonate" .TenantID .Name }}">
            Impersonate
        </button>
        {{ if .RemovableToolTip }}
            <div class="tooltip-wrapper">
                <button class="button is-small" disabled>Remove</button>
                <span class="tooltip">{{ .RemovableToolTip }}</span>
            </div>
        {{ else }}
            <button class="button is-small is-danger is-outlined"
                    hx-delete="{{ printf "/ll-auth/app/admin/tenants/%s/roles/%s" .TenantID .Name }}"
                    hx-target="#add-role-table-and-form">
                Remove
            </button>
        {{ end }}
    </td>
</tr>
{{ end }}

{{ define "tenantAddRoleButton" }}
{{/*string*/}}
<div id="add-role-form">
    <button class="button"
            hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/add-role-form" . }}"
            hx-target="#add-role-form">
        Add Role
    </button>
</div>
{{ end }}

{{ define "tenantAddRoleForm" }}
{{/*string*/}}
<form hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/roles" . }}"
      hx-target="#add-role-table-and-form"
      hx-swap="innerHTML">
    <label>
        <input class="input" type="text" name="role" placeholder="Enter role">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
            hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/add-role-button" . }}"
            hx-target="#add-role-form"
            hx-swap="innerHTML">
        Cancel
    </button>
</form>
{{ end }}

{{ define "addRoleTableAndForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div id="add-role-table-and-form">
    <div class="box">
        <section>
            {{ template "tenantAddRoleButton" .Tenant.ID }}
            <div id="add-role-error-message" class="error-container">{{ .ErrMsg }}</div>
        </section>
        <section>
            <table id="tenant-role-table" class="table">
                <thead>
                    <tr>
                        <th class="narrow-numeric">Members</th>
                        <th>Role Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody hx-target="closest tr" hx-swap="outerHTML">
                    {{ range .Tenant.Roles.Views }}
                        {{ template "roleFragment" . }}
                    {{ end }}
                </tbody>
            </table>
        </section>
    </div>
</div>
{{ end }}

{{ define "subRoleFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.RoleView*/}}
<tr>
    <td>{{ .Name }}</td>
    <td>
        {{ if .RemovableToolTip  }}
            <div class="tooltip-wrapper">
                <button class="button is-small" disabled>
                    Remove
                </button>
                <span class="tooltip">{{ .RemovableToolTip }}</span>
            </div>
        {{ else }}
            <button class="button is-small is-danger is-outlined"
                hx-delete="{{ printf "/ll-auth/app/admin/tenants/%s/sub-roles/%s" .TenantID .Name }}"
                hx-target="#add-sub-role-table-and-form">
                Remove
            </button>
        {{ end }}
    </td>
</tr>
{{ end }}

{{ define "addSubRoleButton" }}
{{/*string*/}}
<div id="add-sub-role-form">
    <button class="button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/add-sub-role-form" . }}"
        hx-target="#add-sub-role-form">
        Add Sub Role
    </button>
</div>
{{ end }}

{{ define "addSubRoleForm" }}
{{/*string*/}}
<form hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/sub-roles" . }}"
      hx-target="#add-sub-role-table-and-form"
      hx-swap="innerHTML">
    <label>
        <input class="input" type="text" name="subrole" placeholder="Enter sub role">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/add-sub-role-button" . }}"
        hx-target="#add-sub-role-form"
        hx-swap="innerHTML">Cancel</button>
</form>
{{ end }}

{{ define "addSubRoleTableAndForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div id="add-sub-role-table-and-form">
    <div class="box">
        <section>
            {{ template "addSubRoleButton" .Tenant.ID }}
            <div id="add-role-error-message" class="error-container">{{ .ErrMsg }}</div>
        </section>
        <section>
            <table id="tenant-sub-role-table" class="table">
                <thead>
                    <tr>
                        <th>Sub Role Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody hx-target="closest tr" hx-swap="outerHTML">
                {{ range .Tenant.SubTenantRoles.Views }}
                    {{ template "subRoleFragment" . }}
                {{ end }}
                </tbody>
            </table>
        </section>
    </div>
</div>
{{ end }}

{{ define "userFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.UserView*/}}
<tr>
    <td>
        <a href="{{ .Link }}">
            {{ .Username }}
        </a>
    </td>
    <td>{{ .Role }}</td>
    <td>{{ .MFAStatus }}</td>
    <td>{{ .Status }}</td>
    <td>
        <div class="buttons are-small">
            {{ if .CanSubjectImpersonate }}
                {{ if .IsSubjectImpersonating }}
                    <button class="button" hx-post="/ll-auth/app/admin/clear-impersonation">
                        Clear Impersonation
                    </button>
                {{ else if not .IsTheSubject }}
                    <button class="button" hx-post="{{ .ImpersonateLink }}">
                        Impersonate
                    </button>
                {{ end }}
            {{ end }}
            {{ if .IsActive }}
                <button class="button is-danger is-outlined" hx-post="{{ .DeactivateLink }}">
                    Deactivate
                </button>
            {{ else if .IsInvited }}
                <button class="button" hx-post="{{ .ReInviteLink }}">
                    Resend Invite
                </button>
                <button class="button" hx-post="{{ .CancelInviteLink }}">
                    Cancel Invite
                </button>
            {{ else if not .IsActive }}
                <button class="button" hx-post="{{ .ActivateLink }}">
                    Activate
                </button>
            {{ end }}
            {{ if .HasMFAPolicyNone }}
                <button class="button" hx-post="{{ .MFAEnableLink }}">
                    Attach MFA
                </button>
            {{ else if and .IsActive .IsMFAActive }}
                <button class="button" hx-post="{{ .MFADisableLink }}">
                    Detach MFA
                </button>
            {{ end }}
        </div>
    </td>
</tr>
{{ end }}

{{ define "inviteButtons" }}
    <div class="container">
        <button class="button"
                hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/invite-user-form" . }}"
                hx-target="#invite-form">
            Invite User
        </button>
        <button class="button"
                hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/bulk-invite-form" . }}"
                hx-target="#invite-form">
            Bulk Invite
        </button>
        <a class="button"
           href="{{ printf "/ll-auth/app/admin/tenants/%s/bulk-invite-template" . }}"
           download="bulk-invite.csv">
            Download Bulk Invite Template
        </a>
    </div>
{{ end }}

{{ define "inviteUserForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<form class="box"
      hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/invite-user-form" .Tenant.ID }}"
      hx-target="#invite-user-table-and-form"
      hx-swap="innerHTML">
    <div class="columns">
        <div class="column">
            {{ if .ErrMsg }}
                <div class="has-text-danger">{{ .ErrMsg }}</div>
            {{ end }}
            <div class="mb-1">
                <label for="username">Email</label>
            </div>
            <div>
                <input class="input" type="email" name="username" id="username" placeholder="Enter email address">
            </div>
            <div class="mt-3 mb-1">
                <label for="role">Role</label>
            </div>
            <div>
                <select class="select" id="role" name="role">
                    {{ range .Roles.Views }}
                        <option value="{{ .Name }}">{{ .Name }}</option>
                    {{ end }}
                </select>
            </div>
            <div class="mt-3 mb-1">
                <label for="mfaPolicy">Multi-Factor Authentication Policy</label>
            </div>
            <div>
                <select class="select" id="mfaPolicy" name="mfaPolicy">
                    {{ range .MFAPolicyStrings }}
                        <option value="{{ . }}">{{ . }}</option>
                    {{ end }}
                </select>
            </div>
        </div>
        <div class="column box">
            <div class="is-size-5">Optional Profile Fields</div>
            {{ range .UserProfileDefinition.Fields }}
                <div class="mt-2">
                    {{ if .UseSelectPossibleValue }}
                        <label>{{ .UIName }}</label>
                        <select class="input" name="fieldValue">
                            {{ $selected := .Value }}
                            {{ range .PossibleValues }}
                                <option value="{{ .ID }}" {{ if eq .ID $selected }}selected{{ end }}>{{ .Name }}</option>
                            {{ end }}
                        </select>
                    {{ else }}
                        <label>{{ .UIName }}</label>
                        <input class="input" type="{{ .HTMLInputType }}" name="fieldValue" value="{{ .Value }}" maxlength="256" autofocus placeholder="Optional">
                    {{ end }}
                </div>
            {{ end }}
        </div>
    </div>
    <button class="button is-primary" type="submit">Submit</button>
    <button class="button" type="button"
            hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/invite-buttons" .Tenant.ID }}"
            hx-target="#invite-form"
            hx-swap="innerHTML">
        Cancel
    </button>
</form>
{{ end }}

{{ define "bulkInviteForm" }}
    {{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
    <form class="box"
          hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/bulk-invite-form" .Tenant.ID }}"
          hx-target="#invite-user-table-and-form"
          hx-swap="innerHTML">
        <div class="block">
            {{ if .ErrMsg }}
                <div class="has-text-danger">{{ .ErrMsg }}</div>
            {{ end }}
            <div class="box">
                <!-- Drag and Drop Area -->
                <div class="drag-area"
                     id="dropZone"
                     hx-on:dragover="event.preventDefault(); this.classList.add('is-dragover')"
                     hx-on:dragleave="this.classList.remove('is-dragover')"
                     hx-on:drop="event.preventDefault(); this.classList.remove('is-dragover'); document.getElementById('fileInput').files = event.dataTransfer.files; document.getElementById('fileName').textContent = event.dataTransfer.files[0].name;"
                >
                    <div class="has-text-centered">
                        <p class="is-size-5 mb-2">Drag and drop bulk invite CSV file here</p>
                        <p class="is-size-7 has-text-grey">or use the file browser below</p>
                    </div>
                </div>

                <!-- File Input with Bulma Styling -->
                <div class="file has-name is-fullwidth mt-4">
                    <label class="file-label">
                        <input class="file-input"
                               id="fileInput"
                               type="file"
                               name="file"
                               hx-on:change="document.getElementById('fileName').textContent = this.files[0].name;"
                        >
                        <span class="file-cta">
                            <span class="file-icon">
                                <i class="fa-sharp fa-upload"></i>
                            </span>
                            <span class="file-label">
                                Choose a file...
                            </span>
                        </span>
                        <span id="fileName" class="file-name">
                            No file selected
                        </span>
                    </label>
                </div>
                <button class="button is-primary"
                        hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/bulk-invite-form" .Tenant.ID }}"
                        hx-encoding="multipart/form-data"
                        hx-include="#fileInput"
                        hx-target="#invite-user-table-and-form">
                    Bulk Invite
                </button>
                <button class="button"
                        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/invite-buttons" .Tenant.ID }}"
                        hx-target="#invite-form"
                        hx-swap="innerHTML">
                    Cancel
                </button>
            </div>
        </div>
    </form>
{{ end }}

{{ define "inviteUserTableAndForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div id="invite-user-table-and-form">
    <div class="block">
        <div class="container" id="invite-form">
            {{ template "inviteButtons" .Tenant.ID }}
        </div>
    </div>
    <div class="box">
        {{ if .Users }}
            <div class="block">
                {{ if eq .TenantTab "invites" }}
                    <div class="is-size-2">Outstanding Invites</div>
                {{ else }}
                    <div class="is-size-2">All Users</div>
                {{ end }}
                <table id="tenant-user-table" class="datatable display">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Role</th>
                            <th>MFA</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody hx-target="closest tr" hx-swap="outerHTML">
                        {{ range .Users }}
                            {{ template "userFragment" . }}
                        {{ end }}
                    </tbody>
                </table>
            </div>
        {{ else }}
            {{ if eq .TenantTab "invites" }}
                <div class="is-size-4">No Outstanding Invites</div>
            {{ else }}
                <div class="is-size-4 has-text-warning">No Users</div>
            {{ end }}
        {{ end }}
    </div>
</div>
{{ end }}

{{ define "tenantSummary" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
    <div class="box">
        <div class="container">
            <div class="columns">
                <!-- Column 1 -->
                <div class="column is-half">
                    <div class="field">
                        <label class="label">Name</label>
                        <span class="value">{{ .Name }}</span>
                    </div>
                    <div class="field">
                        <label class="label">Description</label>
                        {{ template "tenantDescriptionForm" . }}
                    </div>
                    <div class="field">
                        <label class="label">Roles</label>
                        <span class="value">{{ .Roles.Display }}</span>
                    </div>
                    <div class="field">
                        <label class="label">Sub-Roles</label>
                        <span class="value">{{ .SubTenantRoles.Display }}</span>
                    </div>
                </div>

                <!-- Column 2 -->
                <div class="column is-half">
                    <div class="field">
                        <label class="label">Time Created</label>
                        <span class="value">{{ .CreatedAt }}</span>
                    </div>
                    <div class="field">
                        <label class="label">State</label>
                        <span class="value">{{ .State }}</span>
                    </div>
                    <div class="field">
                        <label class="label">Cognito User Pool</label>
                        <span class="value">
                            <i class="fa-brands fa-aws"></i>
                            <a href="{{ .UserPoolCognitoURL }}" target="_blank">{{ .UserPoolID }}</a>
                        </span>
                    </div>
                    <div class="field">
                        <label class="label">User Activity Reports</label>
                        <span class="value">
                            <button class="button is-primary is-outlined" id="runActivityReportBtn"
                                    onclick="downloadInBackground({{ .UserActivityReportLink }}, 'runActivityReportBtn');">
                                Download Activity Report
                            </button>
                        </span>
                        <span class="value">
                            <button class="button is-primary is-outlined" id="runSummaryReportBtn"
                                    onclick="downloadInBackground({{ .UserSummaryReportLink }}, 'runSummaryReportBtn');">
                                Download Summary Report
                            </button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{{ end }}

{{ define "tenantDescriptionForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<span class="value" id="edit-description-form">
    {{ .Description }}
    <button class="icon-button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/description/edit" .ID }}"
        hx-target="#edit-description-form">
        <i class="fa-sharp fa-pen-to-square"></i>
    </button>
</span>
{{ end }}

{{ define "tenantDescriptionEditForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<form hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/description/edit" .ID }}"
    hx-target="#edit-description-form"
    hx-swap="innerHTML">
    <label>
        <input class="input" type="text" name="description" value="{{ .Description }}" maxlength="256">
    </label>
    <button class="button mt-2 is-primary" type="submit">Submit</button>
    <button class="button mt-2" type="button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/description/form" .ID }}"
        hx-target="#edit-description-form"
        hx-swap="innerHTML">Cancel</button>
</form>
{{ end }}

{{ define "tenantTabButtonsFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
    <ul>
        {{ range .TenantTabs }}
            <li class="tab {{ ifElse .Active "is-active" "" }}">
                <a hx-get="{{ .Link }}"
                   hx-target="#tenant-tabs"
                   hx-swap="innerHTML"
                   role="tab"
                   aria-selected="{{ .Active }}"
                   aria-controls="tab-content">
                    {{ .Title }}
                </a>
            </li>
        {{ end }}
    </ul>
{{ end }}

{{ define "tenantSummaryTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tabs" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="container">
    {{ template "tenantSummary" .Tenant }}
</div>
{{ end }}

{{ define "tenantProfileTab" }}
    {{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
    <div class="tabs" role="tablist">
        {{ template "tenantTabButtonsFragment" . }}
    </div>
    <div id="tab-content" role="tabpanel" class="container">
        {{ template "profileCard" .Tenant.Profile }}
    </div>
{{ end }}

{{ define "tenantUsersTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tabs" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="container">
    {{ template "inviteUserTableAndForm" . }}
</div>
{{ end }}

{{ define "tenantInvitesTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tabs" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="container">
    {{ template "inviteUserTableAndForm" . }}
</div>
{{ end }}

{{ define "tenantRolesTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tabs" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
    <div class="box">
        <div class="columns">
            <div class="column is-half">
                <div id="tab-content" role="tabpanel" class="container">
                    {{ template "addRoleTableAndForm" . }}
                </div>
            </div>
            <div class="column is-half">
                {{ if .Tenant.IsRoot }}
                    <div id="tab-content" role="tabpanel" class="container">
                        {{ template "addSubRoleTableAndForm" . }}
                    </div>
                {{ end }}
            </div>
        </div>
    </div>
{{ end }}

{{ define "tenant" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
    <!DOCTYPE html>
    <html lang="en">
    {{ template "header" . }}
    <body>
        {{ template "navbar" . }}
        <section class="section landlord-background-section">
            <div class="container">
                <div class="panel is-info landlord-panel">
                    <p class="panel-heading">Tenant: {{ .Tenant.Name }}</p>
                    <div class="panel-block">
                        <div class="container">
                            <div id="tenant-tabs"
                                 hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/tabs/%s" .Tenant.ID .TenantTab }}"
                                 hx-trigger="load delay:100ms"
                                 hx-target="#tenant-tabs"
                                 hx-swap="innerhtml">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </body>
</html>
{{ end }}
