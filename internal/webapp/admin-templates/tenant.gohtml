{{ define "tenantFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<tr>
    <td><a href="{{ .Link }}">{{ .Name }}</a></td>
    <td>{{ .State }}</td>
    <td>{{ .Description }}</td>
    <td>{{ .UserPoolName }} ({{ .UserPoolID }})</td>
    <td>
        {{ if .IsActive }}
        <a href="{{ printf "/ll-auth/app/admin/tenants/%s?tab=invites" .ID }}">
            <button class="button">Invite</button>
        </a>
        {{ end }}
        {{ if not .IsRoot }}
            {{ if .IsActive }}
                <button class="button"
                        hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/deactivate" .ID }}">
                    Deactivate
                </button>
            {{ else }}
                <button class="button"
                        hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/activate" .ID }}">
                    Activate
                </button>
            {{ end }}
        {{ end }}
    </td>
</tr>
{{ end }}

{{ define "roleFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.RoleView*/}}
<tr>
    <td>{{ .Name }}</td>
    <td>{{ .Count }}</td>
    <td>
        {{ if .RemovableToolTip }}
            <button
                class="button"
                hx-delete="{{ printf "/ll-auth/app/admin/tenants/%s/roles/%s" .TenantID .Name }}"
                hx-target="#add-role-table-and-form">
                Remove
            </button>
        {{ else }}
            <button class="button" disabled>
                Remove
                <span class="tooltip">{{ .RemovableToolTip }}</span>
            </button>
        {{ end }}
    </td>
</tr>
{{ end }}

{{ define "tenantAddRoleButton" }}
{{/*string*/}}
<div id="add-role-form">
    <button class="button"
            hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/add-role-form" . }}"
            hx-target="#add-role-form">
        Add Role
    </button>
</div>
{{ end }}

{{ define "tenantAddRoleForm" }}
{{/*string*/}}
<form class="form-wrapper"
    hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/roles" . }}"
    hx-target="#add-role-table-and-form"
    hx-swap="innerHTML">
    <label>
        <input type="text" name="role" placeholder="Enter role">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
            hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/add-role-button" . }}"
            hx-target="#add-role-form"
            hx-swap="innerHTML">
        Cancel
    </button>
</form>
{{ end }}

{{ define "addRoleTableAndForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div id="add-role-table-and-form">
    {{ template "tenantAddRoleButton" .Tenant.ID }}
    <div id="add-role-error-message" style="color: red; margin-top: 10px;">{{ .ErrMsg }}</div>
    <table>
        <thead>
            <tr>
                <th>Role Name</th>
                <th>Members</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
            {{ range .Tenant.Roles.Views }}
                {{ template "roleFragment" . }}
            {{ end }}
        </tbody>
    </table>
</div>
{{ end }}

{{ define "subRoleFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.RoleView*/}}
<tr>
    <td>{{ .Name }}</td>
    <td>
        {{ if .RemovableToolTip  }}
            <button class="button" disabled>
                Remove
                <span class="tooltip">{{ .RemovableToolTip }}</span>
            </button>
        {{ else }}
            <button class="button"
                hx-delete="{{ printf "/ll-auth/app/admin/tenants/%s/sub-roles/" .Name }}"
                hx-target="#add-sub-role-table-and-form">
                Remove
            </button>
        {{ end }}
    </td>
</tr>
{{ end }}

{{ define "addSubRoleButton" }}
{{/*string*/}}
<div id="add-sub-role-form">
    <button class="button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/add-sub-role-form" . }}"
        hx-target="#add-sub-role-form">
        Add Sub Role
    </button>
</div>
{{ end }}

{{ define "addSubRoleForm" }}
{{/*string*/}}
<form class="form-wrapper"
    hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/sub-roles" . }}"
    hx-target="#add-sub-role-table-and-form"
    hx-swap="innerHTML">
    <label>
        <input type="text" name="subrole" placeholder="Enter sub role">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/add-sub-role-button" . }}"
        hx-target="#add-sub-role-form"
        hx-swap="innerHTML">Cancel</button>
</form>
{{ end }}

{{ define "addSubRoleTableAndForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div id="add-sub-role-table-and-form">
    {{ template "addSubRoleButton" .Tenant.ID }}
{{/*    TODO on this class for error message*/}}
    <div id="add-role-error-message" style="color: red; margin-top: 10px;">{{ .ErrMsg }}</div>
    <table>
        <thead>
            <tr>
                <th>Sub Role Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
        {{ range .Tenant.SubTenantRoles.Views }}
            {{ template "subRoleFragment" . }}
        {{ end }}
        </tbody>
    </table>
</div>
{{ end }}

{{ define "userFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.UserView*/}}
<tr>
    <td>
        <a href="{{ .Link }}">
            {{ .Username }}
        </a>
    </td>
    <td>{{ .Role }}</td>
    <td>{{ .MFAStatus }}</td>
    <td>{{ .Status }}</td>
    <td>
        {{ if .CanSubjectImpersonate }}
            {{ if .IsSubjectImpersonating }}
                <button class="button" hx-post="/ll-auth/app/admin/clear-impersonation">
                    Clear Impersonation
                </button>
            {{ else if not .IsTheSubject }}
                <button class="button" hx-post="{{ .ImpersonateLink }}">
                    Impersonate
                </button>
            {{ end }}
        {{ end }}
        {{ if .IsActive }}
            <button class="button" hx-post="{{ .DeactivateLink }}">
                Deactivate
            </button>
        {{ else if .IsInvited }}
            <button class="button" hx-post="{{ .ReInviteLink }}">
                Resend Invite
            </button>
            <button class="button" hx-post="{{ .CancelInviteLink }}">
                Cancel Invite
            </button>
        {{ else if not .IsActive }}
            <button class="button" hx-post="{{ .ActivateLink }}">
                Activate
            </button>
        {{ end }}
        {{ if .HasMFAPolicyNone }}
            <button class="button" hx-post="{{ .MFAEnableLink }}">
                Attach MFA
            </button>
        {{ else if and .IsActive .IsMFAActive }}
            <button class="button" hx-post="{{ .MFADisableLink }}">
                Detach MFA
            </button>
        {{ end }}
    </td>
</tr>
{{ end }}

{{ define "inviteUserButton" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<div id="invite-user-form">
    <button class="button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/invite-user-form" .Tenant.ID }}"
        hx-target="#invite-user-form">
        Invite User
    </button>
</div>
{{ end }}

{{ define "inviteUserForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<form class="form-wrapper"
    hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/users" .Tenant.ID }}"
    hx-target="#invite-user-table-and-form"
    hx-swap="innerHTML">
    <label>Email:
        <input type="text" name="username" placeholder="Enter email address">
    </label>
    <label>Role:
        <select id="role" name="role">
            {{ range .Roles.Views }}
                <option value="{{ .Name }}">{{ .Name }}</option>
            {{ end }}
        </select>
    </label>
    <label>MFA Policy:
        <select id="mfaPolicy" name="mfaPolicy">
            {{ range .MFAPolicyStrings }}
                <option value="{{ . }}">{{ . }}</option>
            {{ end }}
        </select>
    </label>
    <div>
      <h2>Profile Fields</h2>
        {{ range .UserProfileDefinition.Fields }}
          <div>
            <label>{{ .UIName }}</label>
            <input type="text" name="{{ .Name }}" placeholder="Optional">
          </div>
        {{ end }}
    </div>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/invite-user-button" .Tenant.ID }}"
        hx-target="#invite-user-form"
        hx-swap="innerHTML">
        Cancel
    </button>
</form>
{{ end }}

{{ define "inviteUserTableAndForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div id="invite-user-table-and-form">
    {{ template "inviteUserButton" . }}
{{/*    TODO style*/}}
    <div id="invite-user-error-message" style="color: red; margin-top: 10px;">{{ .ErrMsg }}</div>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th>MFA</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody hx-target="closest tr" hx-swap="outerHTML">
            {{ if not .Users }}
                <p>No Users</p>
            {{ else }}
                {{ range .Users }}
                    {{ template "userFragment" . }}
                {{ end }}
            {{ end }}
        </tbody>
    </table>
</div>
{{ end }}

{{ define "tenantSummary" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<div class="card">
    <div class="card-header">
        <h2>Tenant Summary</h2>
    </div>
    <div class="card-columns">
        <!-- Column 1 -->
        <div class="column">
            <h3>Details</h3>
            <div class="field">
                <span class="label">Name</span>
                <span class="value">{{ .Name }}</span>
            </div>
            <div class="field">
                <span class="label">Description</span>
                {{ template "tenantDescriptionForm" . }}
            </div>
            <div class="field">
                <span class="label">Cognito User Pool</span>
                <span class="value">
                    <i class="fa-brands fa-aws"></i>
                    <a href="{{ .UserPoolCognitoURL }}" target="_blank">{{ .UserPoolID }}</a>
                </span>
            </div>
        </div>

        <!-- Column 2 -->
        <div class="column">
            <h3>Roles</h3>
            <div class="field">
                <span class="label">Roles</span>
                <span class="value">
                    {{ .Roles.Display }}
                    <button class="icon-button"
                        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/roles" .ID }}">
                        <i class="fa-sharp fa-pen-to-square"></i>
                    </button>
                </span>
            </div>
            <div class="field">
                <span class="label">Sub-Roles</span>
                <span class="value">
                    {{ .SubTenantRoles.Display }}
                    <button
                        class="icon-button"
                        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/subroles" .ID }}">
                        <i class="fa-sharp fa-pen-to-square"></i>
                    </button>
                </span>
            </div>
        </div>

        <!-- Column 3 -->
        <div class="column">
            <h3>Additional Information</h3>
            <div class="field">
                <span class="label">Time Created</span>
                <span class="value">{{ .CreatedAt }}</span>
            </div>
            <div class="field">
                <span class="label">State</span>
                <span class="value">{{ .State }}</span>
            </div>
        </div>
    </div>
</div>
{{ end }}

{{ define "tenantDescriptionForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<span class="value" id="edit-description-form">
    {{ .Description }}
    <button class="icon-button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/description/edit" .ID }}"
        hx-target="#edit-description-form">
        <i class="fa-sharp fa-pen-to-square"></i>
    </button>
</span>
{{ end }}

{{ define "tenantDescriptionEditForm" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.TenantView*/}}
<form class="form-wrapper"
    hx-post="{{ printf "/ll-auth/app/admin/tenants/%s/description/edit" .ID }}"
    hx-target="#edit-description-form"
    hx-swap="innerHTML">
    <label>
        <input type="text" name="description" value="{{ .Description }}" maxlength="256">
    </label>
    <button class="button" type="submit">Submit</button>
    <button class="button" type="button"
        hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/description/form" .ID }}"
        hx-target="#edit-description-form"
        hx-swap="innerHTML">Cancel</button>
</form>
{{ end }}

{{ define "tenantTabButtonsFragment" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
    {{ range .TenantTabs }}
        <button class="{{ ifElse .Active "tab-button active" "tab-button" }}"
            hx-get="{{ .Link }}"
            role="tab"
            aria-selected="{{ ifElse .Active "true" "false" }}"
            aria-controls="tab-content">
            {{ .Title }}
        </button>
    {{ end }}
{{ end }}

{{ define "tenantSummaryTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tab-header" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    {{ template "tenantSummary" .Tenant }}
    {{ template "profileCard" .Tenant.Profile }}
</div>
{{ end }}

{{ define "tenantUsersTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tab-header" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    {{ template "inviteUserTableAndForm" . }}
</div>
{{ end }}

{{ define "tenantInvitesTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tab-header" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    {{ template "inviteUserTableAndForm" . }}
</div>
{{ end }}

{{ define "tenantRolesTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tab-header" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    {{ template "addRoleTableAndForm" . }}
</div>
{{ end }}

{{ define "tenantSubrolesTab" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<div class="tab-header" role="tablist">
    {{ template "tenantTabButtonsFragment" . }}
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    {{ template "addSubRoleTableAndForm" . }}
</div>
{{ end }}

{{ define "tenant" }}
{{- /*gotype: github.com/apresdev/landlord/internal/webapp.AuthenticatedSubjectView*/}}
<!DOCTYPE html>
<html lang="en">
    {{ template "header" . }}
    <body>
        {{ template "navbar" . }}
        <div class="container">
            <div id="tabs"
                hx-get="{{ printf "/ll-auth/app/admin/tenants/%s/tabs/%s" .Tenant.ID .TenantTab }}"
                hx-trigger="load delay:100ms"
                hx-target="#tabs"
                hx-swap="innerHTML"></div>
        </div>
    </body>
</html>
{{ end }}
