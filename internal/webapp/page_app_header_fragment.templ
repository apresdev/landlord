package webapp

templ headerFragment(appName string, title string) {
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{ appName } | { title }</title>
    <link rel="stylesheet" href="/ll-auth/app/static/landlord-mgmt.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/ll-auth/app/static/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/ll-auth/app/static/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/ll-auth/app/static/favicon-16x16.png">
    <link rel="manifest" href="/ll-auth/app/static/site.webmanifest">
    <script src="/ll-auth/app/static/htmx.min.js" />
    <script src="/ll-auth/app/static/brands.min.js" />
    <script src="/ll-auth/app/static/sharp-solid.min.js" />
    <script src="/ll-auth/app/static/fontawesome.min.js" />
</head>
}
