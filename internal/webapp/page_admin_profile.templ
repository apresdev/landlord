package webapp

import "github.com/apresdev/landlord/internal/multi"
import "github.com/apresdev/landlord/internal/tinytools"
import "strconv"
import "golang.org/x/text/cases"
import "golang.org/x/text/language"

const profilePageTitle = "Subject Profile"

templ profileTabButtonsFragment(selectedTab profileTab) {
    for _, tab := range profileTabs {
        <button
            hx-get={ appPath("/admin/profile/" + string(tab)) }
            class={ "tab-button" + tinytools.StringIf(tab == selectedTab, " active") }
            role="tab"
            aria-selected={ strconv.FormatBool(tab == selectedTab) }
            aria-controls="tab-content">{ titleDisplay(string(tab)) }</button>
    }
}

templ profileSummaryTab(
    subTenant *multi.Tenant,
    subUser *multi.User,
    subCognitoUser *DisplayableCognitoUser) {
<div class="tab-header" role="tablist">
    @profileTabButtonsFragment(profileTabSummary)
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @userSummaryCard(subTenant, subUser, subCognitoUser)
</div>
}

templ profileTokenDisplay(sub *DisplayableSubject, tok *DisplayableJWT) {
    <div>
        <pre>
            { tok.RawDescription() }
        </pre>
    </div>
}

templ profileTokenTab(
    tab profileTab,
    sub *DisplayableSubject,
    tok *DisplayableJWT) {
<div class="tab-header" role="tablist">
    @profileTabButtonsFragment(tab)
</div>
<div id="tab-content" role="tabpanel" class="tab-content">
    @profileTokenDisplay(sub, tok)
</div>
}

templ profilePage(appName string, sub *DisplayableSubject, startingTab string) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, profilePageTitle)
<body>
    @navBarFragment(sub)
    <div class="container">
        <div id="tabs"
	        hx-get={ appPath("/admin/profile/" + startingTab) }
            hx-trigger="load delay:100ms"
            hx-target="#tabs"
            hx-swap="innerHTML"></div>
    </div>
</body>
</html>
}

