package webapp

const errorPageTitle = "Error"

templ unauthorizedPage(appName string, errMsg string) {
<!DOCTYPE html>
<html lang="en">
@headerFragment(appName, errorPageTitle)
<body>
    @navBarFragment(nil)
    <div class="error-container">
      <h2>Error Occurred</h2>
      <p>{ errMsg }</p>
      <a href="/ll-auth/app/login">Return to Login</a>
    </div>
</body>
</html>
}
