package webapp

import "github.com/apresdev/landlord/internal/multi"

templ navBarFragment(user *multi.User) {
<div class="nav-bar">
    <div class="nav-left">
        <ul>
            <li><a href="/ll-auth/app/admin/dashboard">
                <img src="/ll-auth/app/static/favicon-32x32.png"  alt="Search" />
            </a></li>
            <li><a href="/ll-auth/app/admin/dashboard">Dashboard</a></li>
            <li><a href="/ll-auth/app/admin/tenants">Tenants</a></li>
            <li><a href="/ll-auth/app/admin/invites">Invites</a></li>
            <li><a href="/ll-auth/app/admin/users">Users</a></li>
            <li>
                <label>
                    <input type="text" placeholder="Search...">
                </label>
            </li>
            <li>
                <button type="submit">
                    <i class="fa-sharp fa-solid fa-search fa-2x"></i>
                </button>
            </li>
        </ul>
    </div>
    <div class="nav-right">
        <div class="profile">
            <a href="/ll-auth/app/admin/profile">Profile</a>
            <a href="/ll-auth/app/logout">Logout</a>
        </div>
    </div>
</div>
}
